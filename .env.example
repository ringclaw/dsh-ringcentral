# ══ 密钥类环境变量：插件直接读取的只有这些 ══
# RingCentral Bot 静态 JWT（必填）
RC_BOT_TOKEN=

# RingCentral API 服务器（可选；sandbox 用 https://platform.devtest.ringcentral.com）
RC_SERVER_URL=https://platform.ringcentral.com

# 可选 owner JWT（启用 ringcentral_get_recent_messages + 出站回退；三个需同时设置）
RC_USER_CLIENT_ID=
RC_USER_CLIENT_SECRET=
RC_USER_JWT_TOKEN=

# DeepSeek API（LLM 适配器用）
DEEPSEEK_API_KEY=

# ══ 行为配置请写在 cordis 配置树里（cordis.yml / cordis.patch.yml）══
# Schema 默认值见 src/config.ts；需要环境变量驱动的行为配置用 !!js 标签：
#   access:
#     dmMode: !!js process.env.RC_DM_MODE ?? 'pairing'
