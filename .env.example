# RingCentral bot (static JWT from the RingCentral developer portal)
RC_BOT_TOKEN=

# RingCentral API server (sandbox: https://platform.devtest.ringcentral.com)
RC_SERVER_URL=https://platform.ringcentral.com

# Optional owner JWT app (enables ringcentral_get_recent_messages + outbound fallback)
RC_USER_CLIENT_ID=
RC_USER_CLIENT_SECRET=
RC_USER_JWT_TOKEN=

# Optional access control
RC_DM_POLICY=pairing
RC_ALLOW_FROM=
RC_GROUP_POLICY=disabled
RC_TEAMS=
RC_GROUP_DM_ENABLED=false
RC_GROUP_DM_CHANNELS=
RC_REQUIRE_MENTION=true
RC_THREAD_REQUIRE_MENTION=true
RC_REPLY_TO_MODE=first
RC_HOME_CHANNEL=
RC_HOME_CHANNEL_NAME=

# DeepSeek API
DEEPSEEK_API_KEY=

# Agent working directory (optional)
DSH_CWD=/tmp/dsh-ringcentral
